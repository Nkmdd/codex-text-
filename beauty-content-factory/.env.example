# Copy to .env on the Selectel server, DO NOT COMMIT .env.
# Long unique secret you choose; used for wife-only web upload.
WEB_UPLOAD_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
COOKIE_SECURE=true
DATA_DIR=/data
MAX_UPLOAD_MB=350
MAX_FILES=12

# Phone access: set to your own domain, or e.g. 203.0.113.10.sslip.io
# Requires pointing domain to server public IPv4 and open ports 80 and 443.
DOMAIN=REPLACE_WITH_PUBLIC_DOMAIN

# Obtain from @BotFather for the new bot. Optional until Telegram is ready.
TELEGRAM_BOT_TOKEN=
# Telegram numeric IDs separated by commas; by default nobody can upload to bot.
ALLOWED_TELEGRAM_USERS=
